# Every VITE_* variable read by the client. Copy to .env (never commit .env).
# The app builds and tests run without any of them.

# API origin used by src/lib/api.ts. Leave empty in dev (Vite proxies /api to
# VITE_DEV_API_TARGET). Set to the API origin in production.
VITE_API_URL=

# Dev only (read by vite.config.ts): backend origin that /api is proxied to.
VITE_DEV_API_TARGET=http://localhost:3001

# Supabase project URL and anon (public) key, read by src/lib/supabase.ts.
# Used ONLY by ResetPasswordPage, to read the recovery token from the emailed link.
# The new password itself is set through our API (POST /api/auth/reset-password).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Q02 error tracking (Sentry, D35 in EcoFin-API). Without a DSN nothing is sent.
# The website project's DSN (Sentry -> Settings -> Projects -> ecofin-web -> Client Keys).
VITE_SENTRY_DSN=
# Shown in Sentry. Default: the Vite mode (production on Vercel). Set `development` for the dev site.
VITE_SENTRY_ENVIRONMENT=
